# SV14 production env. Copy to .env.prod on the VPS, fill secrets,
# run: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# Generate strong values:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# IMPORTANT: once postgres / authentik-db volumes initialize with a password,
# changing the password in this env file later will NOT update the DB user
# (postgres skips re-init when data dir is non-empty). To rotate, either:
#   1) docker compose down -v  (wipes ALL volumes — DATA LOSS)
#   2) docker exec ... psql -U <user> -c "ALTER USER ... WITH PASSWORD ...;"
#      and update env to match.

ENV=production
DEBUG=false
PUBLIC_HOSTNAME=sv14.bcse-vju.com
DOMAIN=sv14.bcse-vju.com
TZ=Asia/Ho_Chi_Minh

# --- Postgres (app DB) ---
POSTGRES_DB=labportal
POSTGRES_USER=labportal
POSTGRES_PASSWORD=__GENERATE__
DATABASE_URL=postgresql+asyncpg://labportal:__GENERATE__@postgres:5432/labportal

# --- Redis ---
REDIS_PASSWORD=__GENERATE__
REDIS_URL=redis://:__GENERATE__@redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=__GENERATE_64_CHARS__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OIDC (filled after Authentik first-boot) ---
OIDC_CLIENT_ID=labportal
OIDC_CLIENT_SECRET=__FILL_AFTER_AUTHENTIK_SETUP__
OIDC_ISSUER_URL=https://sv14.bcse-vju.com/auth/application/o/labportal/
OIDC_REDIRECT_URI=https://sv14.bcse-vju.com/api/auth/callback

# --- Authentik ---
AUTHENTIK_SECRET_KEY=__GENERATE_64_CHARS__
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_PASSWORD=__GENERATE__
AUTHENTIK_BOOTSTRAP_PASSWORD=__GENERATE__
AUTHENTIK_BOOTSTRAP_TOKEN=

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lab-noreply@vju.edu.vn
SMTP_PASSWORD=__GMAIL_APP_PASSWORD__
SMTP_FROM=lab-noreply@vju.edu.vn
SMTP_FROM_NAME=VJU Lab Portal

# --- File upload ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# --- Backend SSH key (push into device pool) ---
BACKEND_SSH_KEY_PATH=/app/ssh-keys/portal_admin_ed25519
BACKEND_SSH_KEY_PASSPHRASE=
DEVICE_KEY_ENCRYPTION_KEY=__GENERATE_32_CHARS__

# --- SSH ProxyJump gateway (ADR-0013 / M5.8) ---
# Backend SSHes here to deliver expiry banners + kill stale PIDs (no longer
# to create per-session users; that pattern was retired with M5.8).
SV14_HOST=host.docker.internal
SV14_SSH_PORT=22
SV14_SSH_USER=root
# Public-facing endpoint shown in the SSH command to end users.
# Requires DNAT on Proxmox host: TCP 2222 -> Proxmox host:22, plus
# Cloudflare A-record `ssh.bcse-vju.com` (proxied=OFF) -> Proxmox public IP.
JUMP_HOST_PUBLIC=ssh.bcse-vju.com
JUMP_HOST_PUBLIC_PORT=2222

# --- Plug API ---
PLUG_API_TIMEOUT_SECONDS=10
PLUG_API_RETRY_COUNT=3

# --- Gateway (ADR-0013 / M5.8) ---
# Shared secret backend ↔ PVE jump host PAM. Auto-generated by
# scripts/deploy_lab_portal.py; the same value is pushed to PVE
# (/etc/vlab/gateway.env) so PAM can authenticate to backend.
GATEWAY_SHARED_SECRET=__GENERATE__
GATEWAY_SSH_USERNAME=vlab

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_RESET_PER_MINUTE=3
RATE_LIMIT_UPLOAD_PER_HOUR=10

# --- Booking constraints ---
BOOKING_MAX_DURATION_HOURS=8
BOOKING_DEFAULT_QUOTA_HOURS_PER_WEEK=10
BOOKING_DEFAULT_MAX_CONCURRENT=2
BOOKING_DEFAULT_ADVANCE_DAYS=7

# --- Sessions ---
SESSION_PROVISION_RETRY_COUNT=3
SESSION_KEY_LIFETIME_BUFFER_MINUTES=5
SESSION_GRACE_PERIOD_MINUTES=2

# --- Device pool / plugs ---
DEVICE_POOL_CIDR=192.168.20.0/24
PLUG_POOL_CIDR=192.168.30.0/24

# --- Container images ---
BACKEND_IMAGE=vju-lab-portal-backend:latest
FRONTEND_IMAGE=vju-lab-portal-frontend:latest
