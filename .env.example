# =================
# VJU Lab Portal — Environment variables sample
# Copy file này thành `.env` (cho dev) hoặc `.env.prod` (cho production)
# KHÔNG commit `.env` hoặc `.env.prod` vào git
# =================

# ----- General -----
ENV=development                          # development | staging | production
DEBUG=true                               # false ở prod
DOMAIN=localhost                         # lab.vju.edu.vn ở prod
TZ=Asia/Ho_Chi_Minh

# ----- Database -----
# Dev: localhost (Docker compose)
# Prod: 10.10.10.30 (LXC lab-db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=labportal
POSTGRES_USER=labportal
POSTGRES_PASSWORD=changeme_dev_password
DATABASE_URL=postgresql+asyncpg://labportal:changeme_dev_password@localhost:5432/labportal

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@localhost:6379/0

# ----- JWT / Auth -----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING_FOR_PRODUCTION_USE_NEVER_REUSE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- OIDC (Authentik) -----
# Dev: http://localhost:9000
# Prod: https://lab.vju.edu.vn/auth (qua Caddy proxy tới 10.10.10.40:9000)
OIDC_ISSUER_URL=http://localhost:9000/application/o/labportal/
OIDC_CLIENT_ID=labportal
OIDC_CLIENT_SECRET=changeme_oidc_secret_from_authentik
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ----- Authentik bootstrap (chỉ cần khi setup lần đầu) -----
AUTHENTIK_SECRET_KEY=CHANGE_ME_AUTHENTIK_64_CHARS_RANDOM
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_PASSWORD=changeme_authentik_db
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme_admin

# ----- Email (notification) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lab-noreply@vju.edu.vn
SMTP_PASSWORD=app_password_here
SMTP_FROM=lab-noreply@vju.edu.vn
SMTP_FROM_NAME=VJU Lab Portal

# ----- File upload -----
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100

# ----- Backend SSH key (vào device pool) -----
BACKEND_SSH_KEY_PATH=/app/ssh-keys/backend_admin_ed25519
BACKEND_SSH_KEY_PASSPHRASE=

# AES-256 key dùng encrypt device admin keys lưu DB
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_KEY_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_FOR_AES_256

# ----- Smart plug API -----
PLUG_API_TIMEOUT_SECONDS=10
PLUG_API_RETRY_COUNT=3

# ----- Gateway (ADR-0013 / M5.8) -----
# Shared secret between backend and the PVE jump host PAM script.
# Generate with: openssl rand -hex 32
GATEWAY_SHARED_SECRET=dev_only_gateway_secret_change_me_32_hex_chars_xxxxxxxxxxxxxxxxxx
# Static SSH username users type at `ssh -J <user>@host`.
GATEWAY_SSH_USERNAME=vlab

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_AUTH_URL=http://localhost:9000
NEXT_PUBLIC_DOMAIN=localhost
NEXT_PUBLIC_DEFAULT_LANGUAGE=vi

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----- Rate limiting -----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_RESET_PER_MINUTE=3
RATE_LIMIT_UPLOAD_PER_HOUR=10

# ----- Booking constraints -----
BOOKING_MAX_DURATION_HOURS=8
BOOKING_DEFAULT_QUOTA_HOURS_PER_WEEK=10
BOOKING_DEFAULT_MAX_CONCURRENT=2
BOOKING_DEFAULT_ADVANCE_DAYS=7

# ----- Session management -----
SESSION_PROVISION_RETRY_COUNT=3
SESSION_KEY_LIFETIME_BUFFER_MINUTES=5
SESSION_GRACE_PERIOD_MINUTES=2

# ----- Monitoring (Sentry, optional) -----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----- Production-only -----
LXC_LAB_PROXY_IP=10.10.10.10
LXC_LAB_APP_IP=10.10.10.20
LXC_LAB_DB_IP=10.10.10.30
LXC_LAB_AUTH_IP=10.10.10.40
LXC_LAB_MONITOR_IP=10.10.10.50

DEVICE_POOL_CIDR=192.168.20.0/24
PLUG_POOL_CIDR=192.168.30.0/24
